# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for the admin dashboard (server-only, never exposed to the browser).
# Found in Supabase → Project Settings → API → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps — https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Geocoding API. Restrict key to your domain in production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: override auth redirect (Vercel sets origin automatically in production)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=https://your-app.vercel.app/auth/callback
